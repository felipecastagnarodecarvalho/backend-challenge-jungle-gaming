# Copie para .env se quiser sobrescrever defaults (o app lê process.env; Bun carrega .env automaticamente).
NODE_ENV=development
PORT=3000
# INSTANCE_ID=local-1
LOG_LEVEL=info

DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
TX_MAX_ATTEMPTS=3

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wallet-events.fifo
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_S=30
SQS_WAIT_TIME_S=20
SQS_BATCH_SIZE=10
SQS_RETRY_BASE_S=2
SQS_RETRY_MAX_S=300
SQS_CONSUMER_ENABLED=true

OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=300000

PENDING_REF_WORKER_ENABLED=true
PENDING_REF_POLL_INTERVAL_MS=1000
PENDING_REF_BATCH_SIZE=20
PENDING_REF_LEASE_MS=30000
PENDING_REF_BASE_DELAY_MS=2000
PENDING_REF_MAX_DELAY_MS=300000
PENDING_REF_MAX_ATTEMPTS=10

SHUTDOWN_GRACE_MS=25000

AUTH_ENABLED=false
# AUTH_ISSUER=http://localhost:8080/realms/wagering
# AUTH_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
# AUTH_AUDIENCE=
AUTH_PROVIDER_CLAIM=provider_id

FAULT_INJECTION_ENABLED=false
# FAULT_CRASH_AFTER_COMMIT_MESSAGE_IDS=
# FAULT_CRASH_AFTER_OUTBOX_CLAIM=false
# FAULT_TRANSIENT_MESSAGE_IDS=
# FAULT_DELAY_IN_TX_MS=0
