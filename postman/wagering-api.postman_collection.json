    {
      "name": "1. Wallets",
      "description": "Rode \"Criar wallet\" primeiro: ele gera um playerId novo e salva walletId/playerId nas variáveis da collection.",
      "item": [
        {
          "name": "Criar wallet (saldo inicial 1000.00)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('playerId', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('roundId', 'round-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('walletId', b.id);",
                  "pm.test('saldo 1000.00 e version 1', () => { pm.expect(b.balance.amount).to.eql('1000.00'); pm.expect(b.version).to.eql(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": {\n    \"amount\": \"1000.00\",\n    \"currency\": \"{{currency}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets"
              ]
            },
            "description": "Saldo inicial > 0 gera transação interna OPENING + lançamento CREDIT na mesma transação SQL."
          },
          "response": []
        },
        {
          "name": "Criar wallet duplicada → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test('WALLET_ALREADY_EXISTS', () => pm.expect(pm.response.json().error.code).to.eql('WALLET_ALREADY_EXISTS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
