{
  "info": {
    "name": "Wagering API — Jungle Gaming Challenge",
    "description": "Collection da Distributed Wagering Processor.\n\nComo usar: suba o stack (`docker compose up -d`), importe esta collection e o environment, e rode as pastas em ordem (ou o Collection Runner). \"Criar wallet\" gera um playerId novo a cada execução, então a collection pode ser rodada várias vezes.\n\nbaseUrl aponta para a instância 1 (3001). Instâncias 2 e 3 estão em 3002 e 3003 — todas compartilham o mesmo banco.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Envia Bearer token apenas quando accessToken estiver preenchido (auth é opcional).",
          "const t = pm.collectionVariables.get('accessToken');",
          "if (t && !pm.request.url.toString().includes('/protocol/openid-connect/token')) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + t });",
          "}",
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: 'postman-' + Date.now() });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "providerId",
      "value": "provider-a"
    },
    {
      "key": "currency",
      "value": "BRL"
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "walletId",
      "value": ""
    },
    {
      "key": "roundId",
      "value": "round-987"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "ledgerCursor",
      "value": ""
    }
  ],
  "item": [
